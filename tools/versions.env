QT_VERSION=6.11.2
# M4-W4-T16：clang-tidy 棘轮的钉版（设计 §12.2 静态分析棘轮）。
#   值来源: `python -m pip index versions clang-tidy`（PyPI clang_tidy wheel，win_amd64 + musllinux 同版本）
#   ⇒ 本地与 CI 装同一版本；tools/ci-tidy.py 会断言实测 --version 与本行一致（不符即红）。
#   注: PyPI 无 23.x 的 clang-tidy wheel（clang-format 钉的 23.1.1 无对应件），故棘轮与格式门禁版本不同源。
CLANG_TIDY_VERSION=21.1.0
