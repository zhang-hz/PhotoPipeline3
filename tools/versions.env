# PP-FROZEN(keys): 值必须来自命令输出
VCPKG_TAG=2026.07.29
VCPKG_SHA=9e593bb18ea69cc5095e012465dcd675a822ed0d
QT_VERSION=6.11.2
# M4-W4-T16：clang-tidy 棘轮的钉版（设计 §12.2 静态分析棘轮）。
#   值来源: `python -m pip index versions clang-tidy`（PyPI clang_tidy wheel，win_amd64 + musllinux 同版本）
#   ⇒ 本地与 CI 装同一版本；tools/ci-tidy.py 会断言实测 --version 与本行一致（不符即红）。
#   注: PyPI 无 23.x 的 clang-tidy wheel（clang-format 钉的 23.1.1 无对应件），故棘轮与格式门禁版本不同源。
CLANG_TIDY_VERSION=21.1.0

# M7-WP3（R-128，deep-review-0.3.2）：clang-format 钉版（与 ci-format.sh 的版本断言同源；
#   旧口径散落 ci-format.sh:28 / main-full.yml:96 两处字面量，现统一引用本行）。
#   值来源: tools/bin/clang-format-*.exe/.a 的 `--version` 第一行 = clang-format version 23.1.1。
CLANG_FORMAT_VERSION=23.1.1
# M7-WP3（R-036）：tools/bin/clang-format-* 入库二进制的 sha512 **期望值**（外部信任锚）。
#   消费点 = tools/ci-format.sh（执行前 sha512 校验，不符即红）；与 *.sha512 侧车同值，
#   但侧车与二进制同目录、可被一并篡改 —— 本文件是独立判据（tools/bin 的改动必须同步改这里）。
#   值来源: `python -c "import hashlib;print(hashlib.sha512(open(<bin>,'rb').read()).hexdigest())"`
#   （与 `sha512sum tools/bin/<bin>` 逐字一致，2026-10-11 实测）。
CLANG_FORMAT_SHA512_WIN64=f1c2e5d17439063d5c391fa5ea3de5d834d86112f469ec2051827081ae03f49700d30dcee13354a02972443b056c93456caa2c8a37f8fc8bf700a66e60f51690
CLANG_FORMAT_SHA512_LINUX=00293e74dbef6bfcc269e41b9021e201895b5e27c38b678e8bd60e55873648616faaa573fbca295d2a07f47c33011845244e4f7145f562ed27668aa106cbf433
# M7-WP3（R-039）：构建期 Python 工具链钉版（bootstrap.py 的 pip install 一律引用本组键）。
#   值来源: 仓库内 .toolchain/venv 的 `python -m pip list`（2026-10-11 实测）。
AQTINSTALL_VERSION=3.3.0
CMAKE_VERSION=4.4.3
NINJA_VERSION=1.13.2
