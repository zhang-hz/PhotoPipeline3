{
    "adaptive": {
        "enabled": true,
        "policy": [
            "# JXL 自适应压缩：distance 从当前值每 0.1 往下降，直到达标或到 0.1（越小越清晰）。",
            "version 1",
            "target 90",
            "max_rounds 20",
            "output last",
            "",
            "stage distance-down",
            "  search distance from current down to 0.1 step 0.1 max_rounds 20"
        ]
    },
    "backend": "libjxl",
    "bitdepth": 16,
    "format": "jxl",
    "kind": "format-preset",
    "name": "自适应压缩",
    "params": {
        "distance": 1.0,
        "effort": 4
    },
    "tech": "vardct",
    "version": 1
}
